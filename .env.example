POSTGRES_USER=ps4
POSTGRES_PASSWORD=ps4pass
POSTGRES_DB=ps4_malware
# Host port 5434, not 5432 — matches docker-compose.yml's "5434:5432" mapping
# (avoids clashing with a local Postgres already listening on 5432). Keep the
# two in sync: this said 5433 while compose published 5434, so following the
# example verbatim produced a connection that could never succeed.
DATABASE_URL=postgresql://ps4:ps4pass@localhost:5434/ps4_malware

# Managed providers (Neon, Supabase, Render) hand out a URL with ?sslmode=require
# on the end. Paste it verbatim and keep it on ONE line — backend/app/db.py
# adapts it to asyncpg and psycopg2 automatically. A value wrapped across two
# lines is read truncated and will never connect.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# The backend refuses to start if DATABASE_URL is unreachable, rather than
# falling back to an in-memory store that accepts writes and loses them on
# restart. Set to 1 only if you deliberately want to run without persistence.
ALLOW_DB_FALLBACK=0

# Signing key for the JWT session tokens issued by backend/app/auth.py. There is
# no default: HS256 is symmetric, so a shared or committed value lets anyone who
# has read the source forge an investigator session. The backend refuses to start
# without one. Generate your own (never copy this file's value into a real
# deployment) with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Set to 1 for local work to sign with a random per-process key instead. Tokens
# then break on every restart, which is the point — it is not a shared secret.
ALLOW_DEV_JWT_SECRET=0

REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Where the ingestion gateway (ingestion/gateway.py) saves uploaded sample
# bytes, keyed by sha256 — the backend's ingestion_worker.py consumer reads
# from the same path, so this must be a location both processes can reach
# (a shared volume when running via docker-compose).
INGESTION_SAMPLES_DIR=ingestion_samples

# Comma-separated list of allowed frontend origins for backend/app/main.py's
# CORS middleware. Restrict this before deploying to production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Offline MaxMind GeoLite2-City database for GeoIP lookups on extracted IPs
# (backend/app/geoip.py). Free account + license key required from
# https://www.maxmind.com/en/geolite2/signup — download GeoLite2-City.mmdb
# and point this at it. Left blank, GeoIP lookups are simply skipped.
GEOIP_DB_PATH=

# Optional: MaxMind GeoLite2-ASN database. When set alongside GEOIP_DB_PATH,
# every lookup also returns ASN + ISP/ASN organization for richer network
# attribution (backs the detailed Geo-IP section of the forensic PDF report).
GEOIP_ASN_DB_PATH=

GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
GCP_PROJECT_ID=
GCP_VM_INSTANCE_NAME=
MALWARE_BAZAAR_API_KEY=
# Optional dynamic-analysis providers. Values are read from the process environment.
HYBRID_ANALYSIS_API_KEY=
ALLOW_EXTERNAL_SUBMISSION=false
PROVIDER_DAILY_REQUEST_LIMIT=100
PROVIDER_DAILY_SUBMISSION_LIMIT=20
PROVIDER_DYNAMIC_MAX_CONFIDENCE=0.85
MOBSF_URL=
MOBSF_API_KEY=
MOBSF_DYNAMIC=false
MOBSF_DYNAMIC_ISOLATION_CONFIRMED=false
MOBSF_DYNAMIC_TIMEOUT=
